# Copiar como .env (no se sube al repositorio) y cambiar los valores antes de instalar en un servidor.
#   copy .env.ejemplo .env        (Windows)      cp .env.ejemplo .env        (Linux)
# Docker Compose lee .env automáticamente; si no existe, usa los valores por defecto de docker-compose.yml.

# Clave para firmar las sesiones (JWT). Usar una cadena larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRETO_JWT=cambia-esta-clave-por-una-cadena-larga-y-aleatoria

# Base de datos PostgreSQL del contenedor "db"
POSTGRES_USER=tickets
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=tickets

# Puerto del servidor en el que se publica la aplicación (http://localhost:PUERTO_APP)
PUERTO_APP=8001

# Correcciones válidas necesarias para permitir un reentrenamiento
MIN_CORRECCIONES_REENTRENAR=5

# Horas de validez de una sesión
HORAS_EXPIRACION_TOKEN=8
